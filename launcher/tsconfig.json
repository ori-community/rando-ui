{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@launcher/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@web/*": [
        "../web/*"
      ]
    }
  }
}
