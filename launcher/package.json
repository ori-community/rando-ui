    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/archiver": "^7.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "electron": "^45.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "keywords": [],
