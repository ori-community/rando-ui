    "lodash": "^4.18.1",
    "lookpath": "^1.2.3",
    "semver": "^7.8.5",
    "superjson": "^2.2.6",
    "ws": "^8.22.0",
    "zeromq": "^6.8.0",
    "zod": "^4.6.7"
