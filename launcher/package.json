{
  "name": "@ori-community/rando-ui-launcher",
  "productName": "Ori and the Will of the Wisps Randomizer",
  "version": "1.0.0",
  "description": "Randomizer for the computer game Ori and the Will of the Wisps",
  "main": ".vite/build/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron-forge start",
